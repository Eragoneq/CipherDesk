  "narrative": {
    "northStar": "Familiar Windows utility",
    "overview": "CipherDesk uses a restrained native desktop interface: a muted slate header, medium slate surround, gently lighter data controls, and soft off-white text. The visual priority is selecting local files and checking the effective recipients before an operation. Density supports comparison of contacts, key status, and file outcomes.\n\nThis is a PySide6 application using Qt Fusion. The normative implementation is `cipherdesk/ui.py`: its `STYLE` QSS, widget construction, and layout constraints. Qt supplies standard control mechanics and any palette details not explicitly styled. The sidecar's HTML/CSS entries are documentation previews of existing Qt primitives, not an application frontend.\n\nThe medium slate palette is intended for daytime and evening use, with muted teal actions and no near-black or bright-white working surfaces.",
    "keyCharacteristics": [
      "Familiar Windows typography and standard Qt controls.",
      "Teal actions with visible hover, focus, pressed, and disabled states.",
      "Persistent task tabs and explicit recipient review.",
      "Flat surfaces, fine borders, and text-led feedback.",
      "Scrollable task pages at smaller supported window sizes."
    ],
    "rules": [
      {
        "name": "The Text Before Color Rule",
        "body": "Every key problem and operation outcome must have explicit status text; color is supplementary.",
        "section": "colors"
      },
      {
        "name": "The Reachable Action Rule",
        "body": "At the minimum supported window size, page scrolling must keep output fields, primary actions, and supporting instructions reachable.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve standard Qt keyboard, focus, selection, checkbox, and scrolling behavior.",
      "Do show combined unique recipients before encryption.",
      "Do pair status color with explicit key, error, and signature text.",
      "Do keep output paths and task actions reachable through page scrolling.",
      "Do use Kleopatra for key management and refresh the shared keyring afterward."
    ],
    "donts": [
      "Don't hide missing or unusable recipients from the review table.",
      "Don't replace native utility controls with web cards, custom toggles, or decorative chrome.",
      "Don't imply that a successful local operation completed SharePoint or OneDrive synchronization.",
      "Don't rely on success color to imply that an unsigned sender was authenticated."
    ]
  }
